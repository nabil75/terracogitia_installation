# Terra-Cogitia -- host nginx vhost (HTTPS, Let's Encrypt certificate {{CERT_NAME}}).
# Managed by cogitia-remote.sh (rendered from Installation/remote/nginx) -- do not edit by hand.
# Renewal uses certbot's nginx authenticator: it injects the ACME challenge location into
# the port-80 server block below, so the redirect does not interfere.

server {
    listen 80;
    server_name {{APP_DOMAIN}} {{API_DOMAIN}};

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name {{APP_DOMAIN}};

    ssl_certificate     /etc/letsencrypt/live/{{CERT_NAME}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{CERT_NAME}}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:cogitia_ssl:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:{{FRONTEND_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    server_name {{API_DOMAIN}};

    ssl_certificate     /etc/letsencrypt/live/{{CERT_NAME}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{CERT_NAME}}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:cogitia_ssl:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Audio uploads (Whisper transcription) and long Mistral generations (up to 600 s).
    client_max_body_size 25m;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;

    # Media uploads (Creation Studio): up to 200 MB for video, streamed to the API without buffering.
    location /media/uploads {
        client_max_body_size 210m;
        proxy_request_buffering off;
        proxy_pass http://127.0.0.1:{{BACKEND_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:{{BACKEND_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
